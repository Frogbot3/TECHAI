# Browser key: restrict HTTP referrers to your storefront and local development.
# Enable Maps JavaScript API, Places API (New), and Geocoding API with billing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
# No map ID is required: the picker uses a fixed centre pin, not Advanced Markers.

# Server-only email OTP. Keep the existing real Resend key in .env.local/Vercel.
RESEND_API_KEY=your_resend_api_key
OTP_SENDER_EMAIL="TECH AI <onboarding@resend.dev>"
# Required for resend.dev; exactly one address authorized by your Resend account.
RESEND_TEST_EMAIL=authorized-resend-account@example.com
# After verifying your own sending domain, change OTP_SENDER_EMAIL and remove
# RESEND_TEST_EMAIL to allow all customers. See docs/email-otp-demo.md.
